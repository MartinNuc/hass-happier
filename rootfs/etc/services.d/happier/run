#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# The Happier daemon: registers this machine with your account and starts
# Claude sessions when you ask for one from the Happier app.
exec 2>&1

STATUS="$(/app/happier.sh auth status --json 2>/dev/null || true)"
if [[ -z "${STATUS}" ]] || jq -e '.ok == false and .error.code == "not_authenticated"' <<<"${STATUS}" >/dev/null 2>&1; then
  bashio::log.warning "Happier is not connected yet. Open this add-on's Web UI and click Connect."
  sleep 15
  exit 1
fi

cd /root || exit 1

# Happier always starts Claude with --allow-dangerously-skip-permissions, and
# Claude Code refuses that flag under root unless IS_SANDBOX=1. The add-on
# container is uid 0, so without this every session exits with code 1.
# Happier forwards IS_SANDBOX from the daemon's environment to Claude for
# exactly this case. The declaration is accurate: this container is the
# sandbox, reaching only /homeassistant, /data and the Supervisor API. The
# permission mode is still chosen per session in the Happier app.
export IS_SANDBOX=1

bashio::log.info "Starting the Happier daemon."
exec /app/happier.sh daemon start-sync
